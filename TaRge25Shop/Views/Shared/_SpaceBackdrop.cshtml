<div class="space-background" aria-hidden="true">
    <div class="nebula-cloud nebula-blue"></div><div class="nebula-cloud nebula-violet"></div>
    <div class="cosmic-stars" data-starfield></div>
    <img class="celestial-planet planet-earth" data-drift="planet" data-x="10" data-y="80" src="~/images/worlds/Earth.svg" alt="" draggable="false" asp-append-version="true" />
    <img class="celestial-planet planet-saturn" data-drift="planet" data-x="88" data-y="18" src="~/images/worlds/planet.svg" alt="" draggable="false" asp-append-version="true" />
    <img class="celestial-planet planet-mars" data-drift="planet" data-x="91" data-y="87" src="~/images/worlds/Planet_Mars.svg" alt="" draggable="false" asp-append-version="true" />
    <img class="celestial-planet planet-red" data-drift="planet" data-x="52" data-y="53" src="~/images/worlds/planet-remix-fixed.svg" alt="" draggable="false" asp-append-version="true" />
    <img class="celestial-planet planet-sun" data-drift="planet" data-x="3" data-y="8" src="~/images/worlds/Sun.svg" alt="" draggable="false" asp-append-version="true" />
    <div class="background-ship star-destroyer" data-drift="ship" data-ship="destroyer" data-x="34" data-y="20">
        <img src="~/images/worlds/star-destroyer.webp" alt="" draggable="false" asp-append-version="true" />
    </div>
    <div class="background-ship x-wing fighter-flyby" data-drift="raider" data-hit-chance="0.4">
        <img src="~/images/worlds/x-wing.webp" alt="" draggable="false" asp-append-version="true" />
    </div>
    <div class="background-ship x-wing fighter-flyby flyby-wingman" data-drift="raider" data-hit-chance="0.4">
        <img src="~/images/worlds/x-wing.webp" alt="" draggable="false" asp-append-version="true" />
    </div>
</div>
