@model ErrorViewModel
@{
    ViewData["Title"] = "Viga";
}

<h1 class="text-danger">Tekkis viga.</h1>
<h2 class="text-danger">Päringu töötlemine ebaõnnestus.</h2>

@if (Model.ShowRequestId)
{
    <p><strong>Päringu tunnus:</strong> <code>@Model.RequestId</code></p>
}

<h3>Arendusrežiim</h3>
<p>Arenduskeskkonnas (<code>Development</code>) kuvatakse vea kohta täpsemat teavet.</p>
<p>
    <strong>Avalikus rakenduses ei tohi arendusrežiimi sisse lülitada.</strong>
    Üksikasjalikud veateated võivad kasutajatele avaldada tundlikke andmeid.
    Kohalikuks silumiseks määra keskkonnamuutuja <code>ASPNETCORE_ENVIRONMENT</code> väärtuseks
    <code>Development</code> ja käivita rakendus uuesti.
</p>
