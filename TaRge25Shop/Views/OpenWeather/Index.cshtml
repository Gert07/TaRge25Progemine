@model TaRge25Shop.Models.OpenWeather.OpenWeatherSearchViewModel

@{
    ViewData["Title"] = "Ilm";
}

<h1>Praegune ilm</h1>
<p>Sisesta linn, mille praeguseid ilmatingimusi soovid vaadata.</p>

<form asp-action="SearchWeather" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" maxlength="100" placeholder="Näiteks Tallinn või Tallinn,EE" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Vaata ilma</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
