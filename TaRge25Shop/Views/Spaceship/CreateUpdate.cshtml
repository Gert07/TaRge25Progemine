@model TaRge25Shop.Models.Spaceship.SpaceshipCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>
        Update
    </h1>
}
else
{
    <h1>
        Create
    </h1>
}



<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="UpdatedAt" type="hidden" />

    <div class="form-group row">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" id="CreateUpdateNameEntry" class="form-control" />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="ShipType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ShipType" id="CreateUpdateShipTypeEntry" class="form-control" />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="Crew" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Crew" id="CreateUpdateCrewEntry" class="form-control" />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="EnginePower" id="CreateUpdateEnginePowerEntry" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Files" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-5">
            <div class="custom-file">
                <input class="form-control" asp-for="Files" id="CreateUpdateFilesEntrySpaceship" multiple type="file" />
            </div>
        </div>
    </div>
    <div>
        @foreach (var images in Model.Image)
            {
                <partial name="Images" model="images" />
                <button asp-action="RemoveImage"
                        asp-controller="Spaceship"
                        type="submit"
                        formnovalidate
                        name="imageId"
                        value="@images.ImageId"
                        class="btn btn-danger">
                    Remove Image
                </button>
            }
    </div>

    <hr />
    <br />

    @if (Model.Id.HasValue)
    {
        <input asp-action="Update" asp-controller="Spaceship" id="CreateUpdateUpdateButton" type="submit" class="btn btn-success" value="Update Spaceship" />
    }
    else
    {
        <input asp-action="Create" asp-controller="Spaceship" id="CreateUpdateCreateButton" type="submit" class="btn btn-success" value="Create Spaceship" />
    }

    
    <a asp-action="Index" asp-controller="Spaceship" id="CreateUpdateBackToListButton" class="btn btn-secondary">Back to list</a>
</form>
