@model TaRge25Shop.Models.Spaceship.SpaceshipCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>
        Update
    </h1>
}
else
{
    <h1>
        Create
    </h1>
}



<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="UpdatedAt" type="hidden" />

    <div class="form-group row">
        <label asp-for="Name" for="CU_NameEntrySpaceship" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" id="CU_NameEntrySpaceship" class="form-control" />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="ShipType" for="CU_ShipTypeEntrySpaceship" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ShipType" id="CU_ShipTypeEntrySpaceship" class="form-control" />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="Crew" for="CU_CrewEntrySpaceship" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Crew" id="CU_CrewEntrySpaceship" class="form-control" />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="EnginePower" for="CU_EnginePowerEntrySpaceship" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="EnginePower" id="CU_EnginePowerEntrySpaceship" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Files" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-5">
            <div class="custom-file">
                <input class="form-control" asp-for="Files" multiple type="file" />
            </div>
        </div>
    </div>
    <div>
        @foreach (var images in Model.Image)
            {
                <partial name="Images" model="images" />
                <button asp-action="RemoveImage"
                        asp-controller="Spaceship"
                        type="submit"
                        formnovalidate
                        name="imageId"
                        value="@images.ImageId"
                        class="btn btn-danger">
                    Remove Image
                </button>
            }
    </div>

    <hr />
    <br />

    @if (Model.Id.HasValue)
    {
        <input id="CU_UpdateSpaceship" asp-action="Update" asp-controller="Spaceship" type="submit" class="btn btn-success" value="Update Spaceship" />
    }
    else
    {
        <input id="CU_CreateSpaceship" asp-action="Create" asp-controller="Spaceship" type="submit" class="btn btn-success" value="Create Spaceship" />
    }

    
    <a asp-action="Index" asp-controller="Spaceship" class="btn btn-secondary">Back to list</a>
</form>
