@model TaRge25Shop.Models.Spaceship.SpaceshipDetailViewModel

<div>
    Spaceship Details
</div>
<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="UpdatedAt" type="hidden" />

    <div class="form-group row">
        <span class="col-sm-2 col-form-label">@Html.DisplayNameFor(model => model.Id)</span>
        <div class="col-sm-10">
            <div id="Details_SpaceshipId" class="form-control-plaintext">@Model.Id</div>
        </div>
    </div>
    <div class="form-group row">
        <span class="col-sm-2 col-form-label">@Html.DisplayNameFor(model => model.Name)</span>
        <div class="col-sm-10">
            <div id="Details_SpaceshipName" class="form-control-plaintext">@Model.Name</div>
        </div>
    </div>
    <div class="form-group row">
        <span class="col-sm-2 col-form-label">@Html.DisplayNameFor(model => model.ShipType)</span>
        <div class="col-sm-10">
            <div id="Details_SpaceshipType" class="form-control-plaintext">@Model.ShipType</div>
        </div>
    </div>
    <div class="form-group row">
        <span class="col-sm-2 col-form-label">@Html.DisplayNameFor(model => model.Crew)</span>
        <div class="col-sm-10">
            <div id="Details_SpaceshipCrew" class="form-control-plaintext">@Model.Crew</div>
        </div>
    </div>
    <div class="form-group row">
        <span class="col-sm-2 col-form-label">@Html.DisplayNameFor(model => model.EnginePower)</span>
        <div class="col-sm-10">
            <div id="Details_SpaceshipPower" class="form-control-plaintext">@Model.EnginePower</div>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="CreatedAt" for="Details_SpaceshipCreatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="CreatedAt" id="Details_SpaceshipCreatedAt" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="UpdatedAt" for="Details_SpaceshipUpdatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="UpdatedAt" id="Details_SpaceshipUpdatedAt" class="form-control-plaintext" disabled />
        </div>
    </div>

    @foreach (var images in Model.Image)
    {
        <partial name="Images" model="images" />
    }

    <a asp-action="Index" asp-controller="Spaceship" class="btn btn-secondary">Back to list</a>
</form>
