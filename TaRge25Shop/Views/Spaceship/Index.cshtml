@model IEnumerable<TaRge25Shop.Models.Spaceship.SpaceshipIndexViewModel>
@{
    int rowNumber = 1;
}
<div>
    <a asp-action="Create" asp-controller="Spaceship" id="CreateInIndex" type="submit" class="btn btn-primary">Create Spaceship</a>
</div>
<div class="h1">
    <h1>SpaceShips</h1>
</div>

    <form method="get">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th id="IndexRowNumberColumn" scope="col">Nr</th>
                    <th id="IndexNameColumn" scope="col">Name</th>
                    <th id="IndexTypeColumn" scope="col">Type</th>
                    <th id="IndexBuildDateColumn" scope="col">Build Date</th>
                    <th id="IndexCrewColumn" scope="col">Crew</th>
                    <th id="IndexActionsColumn" scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var spaceship in Model)
                    {
                        <tr>
                            <td id="IndexRowNumberSpaceship">@(rowNumber++)</td>
                            <td id="IndexNameSpaceship">@spaceship.Name</td>
                            <td id="IndexTypeSpaceship">@spaceship.ShipType</td>
                            <td id="IndexBuildDateSpaceship">@spaceship.CreatedAt</td>
                            <td id="IndexCrewSpaceship">@spaceship.Crew</td>
                            <td id="IndexActionsSpaceship">
                        <a asp-action="Details" id="IndexDetailsButton" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        <a asp-action="Update" id="IndexUpdateButton" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-primary">Update</a>
                        <a asp-action="Delete" id="IndexDeleteButton" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
            </tbody>
        </table>
    </form>
