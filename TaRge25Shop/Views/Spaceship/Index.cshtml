@model IEnumerable<TaRge25Shop.Models.Spaceship.SpaceshipIndexViewModel>
@{
    int rowNumber = 1;
}
<div>
    <a asp-action="Create" asp-controller="Spaceship" type="submit" class="btn btn-primary">Lisa kosmoselaev</a>
</div>
<div class="h1">
    <h1>Kosmoselaevad</h1>
</div>

    <form method="get">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">Nr</th>
                    <th scope="col">Nimi</th>
                    <th scope="col">Tüüp</th>
                    <th scope="col">Valmimiskuupäev</th>
                    <th scope="col">Meeskond</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var spaceship in Model)
                    {
                        <tr>
                            <td>@(rowNumber++)</td>
                            <td>@spaceship.Name</td>
                            <td>@spaceship.ShipType</td>
                            <td>@spaceship.CreatedAt</td>
                            <td>@spaceship.Crew</td>
                            <td>
                                <a asp-action="Details" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-primary">Vaata andmeid</a>
                                <a asp-action="Update" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-primary">Muuda</a>
                                <a asp-action="Delete" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-danger">Kustuta</a>
                            </td>
                        </tr>
                    }
            </tbody>
        </table>
    </form>
