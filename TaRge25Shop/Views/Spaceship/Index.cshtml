@model IEnumerable<TaRge25Shop.Models.Spaceship.SpaceshipIndexViewModel>
@{
    int rowNumber = 1;
}
<div>
    <a id="CreateInIndex" asp-action="Create" asp-controller="Spaceship" type="submit" class="btn btn-primary">Create Spaceship</a>
</div>
<div class="h1">
    <h1>SpaceShips</h1>
</div>

    <form method="get">
        <table id="IndexTable" class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">Nr</th>
                    <th scope="col">Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Build Date</th>
                    <th scope="col">Crew</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var spaceship in Model)
                    {
                        <tr data-record-id="@spaceship.Id">
                            <td>@(rowNumber++)</td>
                            <td id="IndexNameSpaceship">@spaceship.Name</td>
                            <td id="IndexTypeSpaceship">@spaceship.ShipType</td>
                            <td id="IndexBuiltDateSpaceship">@spaceship.CreatedAt</td>
                            <td id="IndexCrewSpaceship">@spaceship.Crew</td>
                            <td id="IndexActionsSpaceship">
                                <span id="IndexSpaceshipsId-@spaceship.Id" hidden>@spaceship.Id</span>
                                <a id="IndexSpaceshipDetails" asp-action="Details" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                <a id="IndexSpaceshipUpdate" asp-action="Update" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-primary">Update</a>
                                <a id="IndexSpaceshipDelete" asp-action="Delete" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
            </tbody>
        </table>
    </form>
