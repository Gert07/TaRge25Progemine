@model TaRge25Shop.Models.Spaceship.SpaceshipDeleteViewModel

<div>
    Spaceship Delete
</div>
<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="UpdatedAt" type="hidden" />

    <div class="form-group row">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control-plaintext" diasbled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="ShipType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ShipType" class="form-control-plaintext" disabled/>
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="Crew" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Crew" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="EnginePower" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="CreatedAt" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="UpdatedAt" class="form-control-plaintext" disabled />
        </div>
    </div>

    @foreach (var images in Model.Image)
    {
        <partial name="Images" model="images" />
    }

    <input asp-action="DeleteConfirmation" asp-controller="Spaceship" type="submit" class="btn btn-danger" value="Delete Spaceship" />
    <a asp-action="Index" asp-controller="Spaceship" class="btn btn-secondary">Back to list</a>
</form>