@model TaRge25Shop.Models.Cocktail.CocktailSearchViewModel

@{
    ViewData["Title"] = "Kokteilid";
}

<h1>Kokteilid</h1>
<p>Otsi kokteili nime järgi ning vaata selle koostisosi, koguseid ja valmistamisjuhist.</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p class="alert alert-info" role="status">@Model.Message</p>
}

<form asp-action="SearchCocktail" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="CocktailName" class="form-label"></label>
        <input asp-for="CocktailName" class="form-control" maxlength="100" placeholder="Näiteks Margarita" />
        <span asp-validation-for="CocktailName" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Otsi</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
