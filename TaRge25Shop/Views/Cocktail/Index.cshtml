@model TaRge25Shop.Models.Cocktail.CocktailSearchViewModel

@{
    ViewData["Title"] = "Cocktails";
}

<h1>Cocktails</h1>
<p>Search by name to see the first matching recipe, its ingredients, and preparation instructions.</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p class="alert alert-info" role="status">@Model.Message</p>
}

<form asp-action="SearchCocktail" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="CocktailName" class="form-label"></label>
        <input asp-for="CocktailName" class="form-control" maxlength="100" placeholder="e.g. Margarita" />
        <span asp-validation-for="CocktailName" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<p class="mt-3">Recipes provided by <a href="https://www.thecocktaildb.com/">TheCocktailDB</a>.</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
