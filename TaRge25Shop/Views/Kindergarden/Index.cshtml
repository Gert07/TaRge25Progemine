@model IEnumerable<TaRge25Shop.Models.Kindergarden.KindergardenIndexViewModel>
@{
    int rowNumber = 1;
}
<div>
    <a asp-action="Create" asp-controller="Kindergarden" type="submit" class="btn btn-primary">Lisa lasteaed</a>
</div>
<div class="h1">
    <h1>Lasteaiad</h1>
</div>

<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Rühma nimi</th>
                <th scope="col">Laste arv</th>
                <th scope="col">Lisatud</th>
                <th scope="col">Õpetaja nimi</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kindergarden in Model)
            {
                <tr>
                    <td>@(rowNumber++)</td>
                    <td>@kindergarden.GroupName</td>
                    <td>@kindergarden.ChildrenCount</td>
                    <td>@kindergarden.CreatedAt</td>
                    <td>@kindergarden.TeacherName</td>
                    <td>
                        <a asp-action="Details" asp-controller="Kindergarden" asp-route-id="@kindergarden.Id" class="btn btn-sm btn-outline-primary">Vaata andmeid</a>
                        <a asp-action="Update" asp-controller="Kindergarden" asp-route-id="@kindergarden.Id" class="btn btn-sm btn-outline-primary">Muuda</a>
                        <a asp-action="Delete" asp-controller="Kindergarden" asp-route-id="@kindergarden.Id" class="btn btn-sm btn-outline-danger">Kustuta</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</form>
