@model IEnumerable<TaRge25Shop.Models.Kindergarden.KindergardenIndexViewModel>
@{
    int rowNumber = 1;
}
<div>
    <a id="CreateInIndex" asp-action="Create" asp-controller="Kindergarden" type="submit" class="btn btn-primary">Create Kindergarden</a>
</div>
<div class="h1">
    <h1>Kindergardens</h1>
</div>

<form method="get">
    <table id="IndexTable" class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Group Name</th>
                <th scope="col">Children Count</th>
                <th scope="col">Create Date</th>
                <th scope="col">Teacher Name</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kindergarden in Model)
            {
                <tr data-record-id="@kindergarden.Id">
                    <td>@(rowNumber++)</td>
                    <td id="IndexGroupNameKindergarden">@kindergarden.GroupName</td>
                    <td id="IndexChildrenCountKindergarden">@kindergarden.ChildrenCount</td>
                    <td id="IndexCreatedDateKindergarden">@kindergarden.CreatedAt</td>
                    <td id="IndexTeacherNameKindergarden">@kindergarden.TeacherName</td>
                    <td id="IndexActionsKindergarden">
                        <a id="IndexKindergardenDetails" asp-action="Details" asp-controller="Kindergarden" asp-route-id="@kindergarden.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        <a id="IndexKindergardenUpdate" asp-action="Update" asp-controller="Kindergarden" asp-route-id="@kindergarden.Id" class="btn btn-sm btn-outline-primary">Update</a>
                        <a id="IndexKindergardenDelete" asp-action="Delete" asp-controller="Kindergarden" asp-route-id="@kindergarden.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</form>
