@model TaRge25Shop.Models.Kindergarden.KindergardenDeleteViewModel

<div>
    Kindergarden Delete
</div>
<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="UpdatedAt" type="hidden" />

    <div class="form-group row">
        <label asp-for="Id" for="Delete_KindergardenId" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Id" id="Delete_KindergardenId" class="form-control-plaintext" diasbled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="GroupName" for="Delete_KindergardenGroupName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="GroupName" id="Delete_KindergardenGroupName" class="form-control-plaintext" diasbled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="KindergardenName" for="Delete_KindergardenName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="KindergardenName" id="Delete_KindergardenName" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="ChildrenCount" for="Delete_KindergardenChildrenCount" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ChildrenCount" id="Delete_KindergardenChildrenCount" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="TeacherName" for="Delete_KindergardenTeacherName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="TeacherName" id="Delete_KindergardenTeacherName" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="CreatedAt" for="Delete_KindergardenCreatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="CreatedAt" id="Delete_KindergardenCreatedAt" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="UpdatedAt" for="Delete_KindergardenUpdatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="UpdatedAt" id="Delete_KindergardenUpdatedAt" class="form-control-plaintext" disabled />
        </div>
    </div>

    @if (Model.Images.Count > 0)
    {
        <div class="row mt-3 mb-3">
            @foreach (var image in Model.Images)
            {
                <div class="col-md-4 mb-3">
                    <img src="@Url.Action("GetImage", "Kindergarden", new { id = image.ImageId })"
                         alt="@image.ImageTitle"
                         class="img-fluid rounded"
                         style="width: 100%; height: 250px; object-fit: cover;" />
                </div>
            }
        </div>
    }

    <input id="Delete_Delete" asp-action="DeleteConfirmation" asp-controller="Kindergarden" type="submit" class="btn btn-danger" value="Delete Kindergarden" />
    <a asp-action="Index" asp-controller="Kindergarden" class="btn btn-secondary">Back to list</a>
</form>
