@model TaRge25Shop.Models.RealEstate.RealEstateDetailVM

<div>
    Real Estate Details
</div>
<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="ModifiedAt" type="hidden" />

    <div class="form-group row">
        <label asp-for="Id" for="Details_RealEstateId" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Id" id="Details_RealEstateId" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="Area" for="Details_RealEstateArea" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Area" id="Details_RealEstateArea" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="Location" for="Details_RealEstateLocation" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Location" id="Details_RealEstateLocation" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="RoomNumber" for="Details_RealEstateRoomNumber" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="RoomNumber" id="Details_RealEstateRoomNumber" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="BuildingType" for="Details_RealEstateBuildingType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="BuildingType" id="Details_RealEstateBuildingType" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="CreatedAt" for="Details_RealEstateCreatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="CreatedAt" id="Details_RealEstateCreatedAt" class="form-control-plaintext" disabled />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="ModifiedAt" for="Details_RealEstateModifiedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ModifiedAt" id="Details_RealEstateModifiedAt" class="form-control-plaintext" disabled />
        </div>
    </div>

    @if (Model.Images.Count > 0)
    {
        <div class="row mt-3 mb-3">
            @foreach (var image in Model.Images)
            {
                <div class="col-md-4 mb-3">
                    <img src="@Url.Action("GetImage", "RealEstate", new { id = image.ImageId })"
                         alt="@image.ImageTitle"
                         class="img-fluid rounded"
                         style="width: 100%; height: 250px; object-fit: cover;" />
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">No images uploaded.</p>
    }

    <a asp-action="Index" asp-controller="RealEstate" class="btn btn-secondary">Back to list</a>
</form>
